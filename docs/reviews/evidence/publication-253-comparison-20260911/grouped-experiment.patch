+import { canonicalJson } from "../../src/catalogue/shared/serialization";
+import { createHash } from "node:crypto";
+// ISOLATED EXPERIMENT ONLY: records method entries and emulator metadata, never billing.
+export const measurement = {
+  phase: "unmeasured", phases: {} as Record<string, any>, callbacks: {} as Record<string, any>,
+  active: false, fault: "", faulted: false, faultReplayComplete: false, replayResultEqual: false,
+};
+function phase() { return measurement.phases[measurement.phase] ??= { ms: 0, child_ms: 0, calls: {}, rows_read: 0, rows_written: 0, statements: 0, returned_object_bytes: 0 }; }
+function count(key: string, n = 1) { if (measurement.active) { const p=phase(); p.calls[key]=(p.calls[key]??0)+n; } }
+export async function measured<T>(name: string, fn: () => Promise<T>): Promise<T> {
+  const old=measurement.phase; measurement.phase=name; const p=phase(); const start=performance.now();
+  try { return await fn(); } finally { const elapsed=performance.now()-start; p.ms+=elapsed; const parent=measurement.phases[old];if(parent)parent.child_ms+=elapsed; measurement.phase=old; }
+}
+(globalThis as any).__publicationMeasure = measured;
+function meta(result: any) { if (!measurement.active) return; for(const r of Array.isArray(result)?result:[result]) { const m=r?.meta; if(m) { phase().rows_read+=m.rows_read??0; phase().rows_written+=m.rows_written??0; } } }
+export function measuredEnvironment<T extends object>(env: T): T {
+  const cache=new Map<PropertyKey,any>();
+  return new Proxy(env,{get(target,key) {
+    if(cache.has(key)) return cache.get(key);
+    const original=Reflect.get(target,key);
+    if(key==='CATALOGUE_DB') {
+      const originals=new WeakMap<object,any>();
+      function statement(s:any):any {
+        const wrapped=new Proxy(s,{get(target,key) {
+          if(key==='bind') return (...args:any[])=>statement(target.bind(...args));
+          if(['first','all','raw','run'].includes(String(key))) return async(...args:any[])=>{
+            count('D1.'+String(key)); if(measurement.active) phase().statements++;
+            if(key==='first') {
+              // Same SQL and one real D1 query; retain emulator metadata before returning its first row.
+              const result=await target.all();meta(result);const row=result.results[0]??null;
+              if(args[0]!==undefined && row!==null && !(args[0] in row))throw new Error('D1_COLUMN_NOTFOUND');
+              return args[0]===undefined?row:row?.[args[0]]??null;
+            }
+            const result=await target[key](...args);meta(result);return result;
+          };
+          const v=Reflect.get(target,key);return typeof v==='function'?v.bind(target):v;
+        }}); originals.set(wrapped,s);return wrapped;
+      }
+      const proxy=new Proxy(original,{get(target,key) {
+        if(key==='prepare') return (sql:string)=>statement(target.prepare(sql));
+        if(key==='batch') return async (ss:any[])=> { count('D1.batch'); if(measurement.active)phase().statements+=ss.length; const r=await target.batch(ss.map(s=>originals.get(s)??s)); meta(r); return r; };
+        const v=Reflect.get(target,key);return typeof v==='function'?v.bind(target):v;
+      }});cache.set(key,proxy);return proxy;
+    }
+    if(['CATALOGUE_EXPORTS','EVIDENCE_OBJECTS','BACKUPS','PRINTING_IMAGES'].includes(String(key))) {
+      const proxy=new Proxy(original,{get(target,method) {
+        if(['get','head','put','delete','list'].includes(String(method)))return async(...args:any[])=>{
+          count(String(key)+'.'+String(method));
+          const r=await target[method](...args);
+          if(measurement.active && ['get','head'].includes(String(method))){phase().returned_object_bytes+=r?.size??0;const f=method==='get'?'get_object_bytes':'head_declared_bytes';phase()[f]=(phase()[f]??0)+(r?.size??0);}
+          if(measurement.active && method==='put')count(String(key)+'.'+(r===null?'conditional_reuse':'put_success'));
+          if(measurement.fault==='after-put' && !measurement.faulted && method==='put' && String(args[0]).startsWith('catalogue-public-components/')) {
+            measurement.faulted=true; throw new Error('EXPERIMENT lost successful R2 PUT response');
+          }
+          return r;
+        };
+        const v=Reflect.get(target,method);return typeof v==='function'?v.bind(target):v;
+      }});cache.set(key,proxy);return proxy;
+    }
+    return original;
+  }});
+}
+export async function measuredStep(name:string, callback:()=>Promise<any>) {
+  const category=name.startsWith('prepare publication artifacts')?'private':name.startsWith('prepare public export')?'public':name==='export, retain, restore, and verify Catalogue D1'?'backup':measurement.phase==='candidate'?'candidate-workflow':'workflow-other';
+  if(category==='public' && measurement.fault && !measurement.faultReplayComplete) {
+    measurement.faultReplayComplete=true;
+    let failed=false;
+    try { await measured('interruption.failed-unit', callback); } catch(error) {if(!(error instanceof Error)||!error.message.includes('EXPERIMENT lost successful R2 PUT response'))throw error;failed=true;}
+    if(!failed)throw new Error('Expected injected storage-response loss');
+    const retried=await measured('interruption.retried-unit',callback);
+    const replayed=await measured('interruption.committed-replay',callback);
+    measurement.replayResultEqual=canonicalJson(retried)===canonicalJson(replayed);
+    if(!measurement.replayResultEqual)throw new Error('Committed callback replay changed its response');
+    return retried;
+  }
+  const stats=measurement.callbacks[category]??={count:0,ms:0,max_ms:0,max_calls:0};
+  const start=performance.now();let calls=0;
+  const categoryPhase=measurement.phases[category];const before=Object.entries(categoryPhase?.calls??{}).filter(([k])=>!k.endsWith('put_success')&&!k.endsWith('conditional_reuse')).reduce((s:number,[,n]:any)=>s+n,0);
+  try {return await measured(category,callback);} finally {stats.count++; const elapsed=performance.now()-start;stats.ms+=elapsed;stats.max_ms=Math.max(stats.max_ms,elapsed);const after=Object.entries(measurement.phases[category]?.calls??{}).filter(([k])=>!k.endsWith('put_success')&&!k.endsWith('conditional_reuse')).reduce((s:number,[,n]:any)=>s+n,0);stats.max_calls=Math.max(stats.max_calls,after-before);}
+}
+
+const originalFetch=globalThis.fetch;
+globalThis.fetch=(async(input:any,init:any)=>{
