+import {prepareNativeCandidate,approveNativeCandidate} from "./native-publication-helpers";
+import {installReconciliationSuite,testEnv,collect,requiredString,exportComponentRecords} from "./reconciliation-helpers";
+installReconciliationSuite();
+test('ISOLATED storage-response loss then committed public callback replay',async(context)=>{
+ resetExperimentIds();measurement.phases={};measurement.callbacks={};measurement.active=true;measurement.fault='after-put';measurement.faulted=false;measurement.faultReplayComplete=false;
+ const report:any={contract:'isolated-publication-interruption@1'};context.task.meta.publicationExperiment=report;
+ try {
+  const run=await collect('/reconciliation/scale-64-products-experiment','fault-experiment');
+  const candidate=await prepareNativeCandidate(run.id,'one-piece','catrev_spine_000','fault-candidate');
+  const published=await approveNativeCandidate(candidate,'fault-publication');
+  const revision=requiredString(published.document,'resulting_revision_id');
+  expect(measurement.faulted).toBe(true);expect(measurement.replayResultEqual).toBe(true);
+  for(const kind of ['cards','products','releases','distribution-contexts'])expect(await exportComponentRecords(revision,kind)).toHaveLength(64);
+  const components=(await testEnv.CATALOGUE_DB.prepare('SELECT object_key,sha256,byte_length,descriptor_json FROM publication_export_components WHERE candidate_id=?').bind(candidate.id).all<any>()).results;
+  for(const c of components){const o=await testEnv.CATALOGUE_EXPORTS.get(c.object_key);expect(o?.size).toBe(c.byte_length);expect(await sha256(await o!.arrayBuffer())).toBe(c.sha256);}
+  report.components=components.length;report.max_group_records=Math.max(...components.map(c=>JSON.parse(c.descriptor_json).records));
+  report.completed=true;
+ }finally{measurement.active=false;measurement.fault='';report.phases=measurement.phases;report.replayed_equal=measurement.replayResultEqual;report.fault_applied=measurement.faulted;}
+},180_000);
