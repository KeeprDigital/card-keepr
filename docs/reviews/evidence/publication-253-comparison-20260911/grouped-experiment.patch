+ count('HTTP.'+(init?.method??input?.method??'GET')+'.'+url.hostname+'.'+url.pathname.replace(/[a-f0-9]{20,}/g,'ID'));
+ return originalFetch(input,init);
+}) as typeof fetch;
+
+let identifierSequence=0;
+export function resetExperimentIds(){identifierSequence=0;}
+crypto.randomUUID=(()=>{const h=createHash('sha256').update('publication-layout-fixture:'+identifierSequence++).digest('hex');return `${h.slice(0,8)}-${h.slice(8,12)}-4${h.slice(13,16)}-8${h.slice(17,20)}-${h.slice(20,32)}`;}) as typeof crypto.randomUUID;
