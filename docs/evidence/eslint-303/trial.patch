diff --git a/lint-trial/validate.mjs b/lint-trial/validate.mjs
new file mode 100644
--- /dev/null
+++ b/lint-trial/validate.mjs
@@ -0,0 +1,36 @@
+// Validate the unchanged repository tasks against the candidate dependencies.
+// Faulty probes/config experiments are moved aside so they cannot enter normal lint.
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, renameSync, mkdirSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+const temporary = mkdtempSync(join(tmpdir(), "eslint-303-validation-"));
+const artifacts = ["lint-trial", "eslint.config.mjs", "prettier.config.mjs", "biome.trial.jsonc", ".prettierignore"];
+const moved = [];
+const results = [];
+try {
+  for (const file of artifacts) { renameSync(file, join(temporary, file)); moved.push(file); }
+  const output = join(temporary, "lint-trial/results");
+  mkdirSync(output, { recursive: true });
+  for (const [name, args] of [
+    ["frozen-install", ["install", "--frozen-lockfile"]],
+    ["domain-focused", ["run", "test:domain", "source-host-pacing-mode"]],
+    ["api-focused", ["run", "test:api", "apps/api/test/health.spec.ts"]],
+    ["ingestion-focused", ["run", "test:ingestion", "apps/ingestion/test/evidence-cleanup.spec.ts"]],
+    ["acceptance-smoke", ["run", "test:acceptance:smoke"]],
+    ["check", ["run", "check"]],
+    ["full", ["run", "test:full"]],
+  ]) {
+    const start = Date.now();
+    const result = spawnSync("pnpm", args, { encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
+    if (result.error) throw result.error;
+    writeFileSync(join(output, `validation-${name}.log`), result.stdout + result.stderr);
+    results.push({ name, command: ["pnpm", ...args], exit: result.status, seconds: (Date.now() - start) / 1000 });
+    console.log(results.at(-1));
+    if (result.status !== 0) throw new Error(`Validation failed: ${name}; inspect its saved log.`);
+  }
+} finally {
+  for (const file of moved.reverse()) renameSync(join(temporary, file), file);
+  writeFileSync("lint-trial/results/validation.json", `${JSON.stringify(results, null, 2)}\n`);
+  rmSync(temporary, { recursive: true, force: true });
+}
