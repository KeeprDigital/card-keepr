@@ -0,0 +1,35 @@
+import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import { spawnSync } from "node:child_process";
+import { performance } from "node:perf_hooks";
+import { ESLint } from "eslint";
+import * as prettier from "prettier";
+const output = "lint-trial/results";
+mkdirSync(output, { recursive: true });
+const files = ["src/catalogue/source-evidence/collection-recovery.ts", "cli/lib/config.mjs", "apps/ingestion/wrangler.jsonc", "apps/ingestion/tsconfig.json", "README.md", ".github/workflows/ci.yml"];
+const formatting = [];
+for (const file of files) {
+  const original = readFileSync(file, "utf8");
+  const formatted = await prettier.format(original, { ...await prettier.resolveConfig(file), filepath: file });
+  const formattedPath = `${output}/formatted-${file.replaceAll("/", "_")}.txt`;
+  writeFileSync(formattedPath, formatted);
+  const result = spawnSync("git", ["diff", "--no-index", "--numstat", "--", file, formattedPath], { encoding: "utf8" });
+  formatting.push({ file, changed: original !== formatted, diff: result.stdout.trim(), stable: formatted === await prettier.format(formatted, { ...await prettier.resolveConfig(file), filepath: file }) });
+  writeFileSync(`${output}/formatted-${file.replaceAll("/", "_")}.txt`, formatted);
+}
+const file = "lint-trial/probes/worker.ts";
+const input = readFileSync(file, "utf8");
+const eslint = new ESLint();
+const timings = [];
+for (let sample = 0; sample < 3; sample++) {
+  const start = performance.now();
+  const [result] = await eslint.lintText(input, { filePath: file });
+  timings.push({ sample, seconds: (performance.now() - start) / 1000, diagnostics: result.messages.length, suggestions: result.messages.filter((message) => message.suggestions?.length).map((message) => ({ rule: message.ruleId, messages: message.suggestions.map((suggestion) => suggestion.desc) })) });
+}
+const safeFile = "cli/lib/secret-input.mjs";
+const [safeFixed] = await new ESLint({ fix: true }).lintText(readFileSync(safeFile, "utf8"), { filePath: safeFile });
+writeFileSync(`${output}/safe-fixes.txt`, safeFixed.output ?? readFileSync(safeFile, "utf8"));
+const fixer = new ESLint({ fix: true, fixTypes: ["problem"] });
+const [fixed] = await fixer.lintText(input, { filePath: file });
+writeFileSync(`${output}/problem-fixes.txt`, fixed.output ?? input);
+writeFileSync(`${output}/editor-format.json`, `${JSON.stringify({ formatting, timings, problemFixChanged: Boolean(fixed.output), remainingDiagnostics: fixed.messages.length, safeFixFile: safeFile, safeFixChanged: Boolean(safeFixed.output), actualEditorVerified: false }, null, 2)}\n`);
+console.log({ formatting, timings: timings.map(({ sample, seconds, diagnostics }) => ({ sample, seconds, diagnostics })), problemFixChanged: Boolean(fixed.output), remainingDiagnostics: fixed.messages.length });
