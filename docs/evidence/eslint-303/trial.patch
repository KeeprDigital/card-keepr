@@ -0,0 +1,67 @@
+// This runner parses/lints probe files. It never imports or executes them.
+import assert from "node:assert/strict";
+import { readFileSync, mkdirSync, writeFileSync } from "node:fs";
+import { spawnSync } from "node:child_process";
+import { ESLint } from "eslint";
+const output = "lint-trial/results";
+mkdirSync(output, { recursive: true });
+const eslint = new ESLint();
+const results = await eslint.lintFiles(["lint-trial/probes"]);
+const expected = {
+  "worker.ts": {
+    local: "@typescript-eslint/no-floating-promises",
+    imported: "@typescript-eslint/no-floating-promises",
+    d1: "@typescript-eslint/no-floating-promises",
+    "r2-put": "@typescript-eslint/no-floating-promises",
+    "r2-delete": "@typescript-eslint/no-floating-promises",
+    "bare-void": "@typescript-eslint/no-floating-promises",
+    callback: "@typescript-eslint/no-misused-promises",
+    condition: "@typescript-eslint/no-misused-promises",
+    "await-number": "@typescript-eslint/await-thenable",
+    union: "@typescript-eslint/switch-exhaustiveness-check",
+    "unsafe-assignment": "@typescript-eslint/no-unsafe-assignment",
+    "unsafe-return": "@typescript-eslint/no-unsafe-return",
+    "unnecessary-condition": "@typescript-eslint/no-unnecessary-condition",
+    "return-await": "@typescript-eslint/return-await",
+  },
+  "assertions.spec.ts": { focus: "vitest/no-focused-tests", "unawaited-expect": "vitest/valid-expect", "invalid-expect": "vitest/valid-expect" },
+  "assertions.test.mjs": { "node-unawaited": "@typescript-eslint/no-floating-promises", "node-imported": "@typescript-eslint/no-floating-promises" },
+  "plugins.mjs": { "unresolved-import": "import-x/no-unresolved", "ignored-return": "sonarjs/no-ignored-return", "fetch-body": "unicorn/no-invalid-fetch-options", "regex": "regexp/no-useless-assertions", "node-promise": "@typescript-eslint/no-floating-promises" },
+};
+for (const [file, probes] of Object.entries(expected)) {
+  const lines = readFileSync(`lint-trial/probes/${file}`, "utf8").split("\n");
+  const result = results.find((result) => result.filePath.endsWith(`/probes/${file}`));
+  assert.ok(result, `Missing lint result: ${file}`);
+  assert.equal(result.fatalErrorCount, 0, `Parse failure: ${file}`);
+  for (const [probe, rule] of Object.entries(probes)) {
+    const line = lines.findIndex((line) => line.endsWith(`// probe:${probe}`)) + 1;
+    assert.ok(line > 0, `Missing marker: ${probe}`);
+    assert.ok(result.messages.some((message) => message.line === line && message.ruleId === rule), `${file}:${line}: missing ${rule}`);
+  }
+}
+for (const file of ["valid.ts", "valid.jsonc", "service.ts"]) {
+  assert.deepEqual(results.find((result) => result.filePath.endsWith(`/probes/${file}`))?.messages, [], `Valid control: ${file}`);
+}
+for (const file of ["duplicate.json", "duplicate.jsonc"]) {
+  assert.ok(results.find((result) => result.filePath.endsWith(`/probes/${file}`))?.messages.some((message) => message.ruleId === "json/no-duplicate-keys"));
+}
+// The test framework owns registrations, but not discarded assertions in their bodies.
+assert.deepEqual(results.find((result) => result.filePath.endsWith("/probes/assertions.test.mjs"))?.messages.map(({ line }) => line), [5, 9]);
+// Awaited/returned/combined assertions and the optional message are valid.
+// Line 11 deliberately uses a non-Promise .resolves input: a recorded lint gap.
+assert.deepEqual(results.find((result) => result.filePath.endsWith("/probes/assertions.spec.ts"))?.messages.map(({ line }) => line), [2, 5, 5, 8]);
+writeFileSync(`${output}/probes-eslint.json`, `${JSON.stringify(results.map(({ filePath, messages }) => ({ file: filePath.replace(`${process.cwd()}/`, ""), messages })), null, 2)}\n`);
+for (const improved of [false, true]) {
+  const result = spawnSync("pnpm", ["exec", "biome", "lint", "lint-trial/probes", "--reporter=json", ...(improved ? ["--config-path", "biome.trial.jsonc"] : [])], { encoding: "utf8" });
+  if (result.error) throw result.error;
+  assert.equal(result.status, 1, "Invalid probes should fail lint");
+  writeFileSync(`${output}/probes-biome${improved ? "-improved" : ""}.json`, `${JSON.stringify(JSON.parse(result.stdout), null, 2)}\n`);
+}
+const [nodeInvalid] = await eslint.lintText("export const workerGlobalInNode = self;\n", { filePath: "cli/lib/config.mjs" });
+const [nodeValid] = await eslint.lintText("export const nodeVersion = process.version;\n", { filePath: "cli/lib/config.mjs" });
+const [workerValid] = await eslint.lintText("export const workerSelf = self;\n", { filePath: "src/http/diagnostic-display.mjs" });
+assert.ok(nodeInvalid.messages.some(({ ruleId }) => ruleId === "no-undef"), "Node must reject Worker-only globals");
+assert.deepEqual(nodeValid.messages, [], "Node globals remain available");
+assert.deepEqual(workerValid.messages, [], "Worker globals remain available");
+writeFileSync(`${output}/runtime-globals.json`, `${JSON.stringify({ nodeInvalid: nodeInvalid.messages, nodeValid: nodeValid.messages, workerValid: workerValid.messages }, null, 2)}\n`);
+console.log("26 invalid-case rule assertions and valid controls plus separate runtime globals passed; probes were never executed.");
diff --git a/lint-trial/scan.mjs b/lint-trial/scan.mjs
new file mode 100644
--- /dev/null
+++ b/lint-trial/scan.mjs
@@ -0,0 +1,45 @@
+import { execFileSync, spawnSync } from "node:child_process";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { performance } from "node:perf_hooks";
+import { ESLint } from "eslint";
+
+const excluded = /^(?:prototype|acceptance\/fixtures)\/|worker-configuration\.d\.ts$|^src\/catalogue\/shared\/document-validators\.mjs$/;
+const files = execFileSync("git", ["ls-tree", "-r", "--name-only", "HEAD"], { encoding: "utf8" })
+  .trim().split("\n").filter((file) => /\.(?:ts|mts|mjs|json|jsonc)$/.test(file) && !excluded.test(file));
+const output = "lint-trial/results";
+mkdirSync(output, { recursive: true });
+writeFileSync(`${output}/files.json`, `${JSON.stringify(files, null, 2)}\n`);
+const timings = [];
+const mode = process.argv[2] ?? "scan";
+if (mode === "scan") {
+  const eslint = new ESLint();
+  const start = performance.now();
+  const results = await eslint.lintFiles(files);
+  timings.push({ task: process.env.ESLINT_TRIAL_RAW === "1" ? "eslint-raw" : "eslint-curated", seconds: (performance.now() - start) / 1000 });
+  const normalized = results.map(({ filePath, messages }) => ({ file: filePath.replace(`${process.cwd()}/`, ""), messages }));
+  writeFileSync(`${output}/${process.env.ESLINT_TRIAL_RAW === "1" ? "raw" : "curated"}.json`, `${JSON.stringify(normalized)}\n`);
+  writeFileSync(`${output}/coverage.json`, `${JSON.stringify(await Promise.all(files.filter((f) => /\.(?:ts|mts|mjs)$/.test(f)).map(async (file) => {
+    const config = await eslint.calculateConfigForFile(file);
+    return { file, project: config?.languageOptions?.parserOptions?.project, floating: config?.rules?.["@typescript-eslint/no-floating-promises"], vitest: config?.rules?.["vitest/valid-expect"] ?? null };
+  })), null, 2)}\n`);
+} else if (mode === "time") {
+  for (const [task, command, args] of [
+    ["biome", "biome", ["lint", "--reporter=json"]],
+    ["biome-improved", "biome", ["lint", "--config-path", "biome.trial.jsonc", "--reporter=json"]],
+    ["eslint", "eslint", ["--format", "json"]],
+    ["eslint-cache", "eslint", ["--cache", "--cache-location", `${output}/eslint-cache`, "--format", "json"]],
+  ]) {
+    for (let sample = 0; sample < 3; sample++) {
+      const start = performance.now();
+      const result = spawnSync("pnpm", ["exec", command, ...args, ...files], { encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
+      if (result.error) throw result.error;
+      timings.push({ task, sample, seconds: (performance.now() - start) / 1000, exit: result.status });
+      if (sample === 0) {
+        writeFileSync(`${output}/${task}-stdout.json`, result.stdout);
+        writeFileSync(`${output}/${task}-stderr.txt`, result.stderr);
+      }
+    }
+  }
+}
+writeFileSync(`${output}/${process.env.ESLINT_TRIAL_RAW === "1" ? "raw-" : ""}${mode}-timings.json`, `${JSON.stringify(timings, null, 2)}\n`);
+console.log(timings);
