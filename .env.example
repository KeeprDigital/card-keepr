# card-keepr owner secrets and settings: the inventory of names. No values here.
#
# Copy to `.env` in the main checkout (git-ignored, chmod 600). The keepr CLI and
# `pnpm release:staging|production` read it literally (no shell expansion) from
# the main checkout, also when run from a worktree; explicit environment
# variables win, and KEEPR_OWNER_ENV_FILE=<absolute path> names another file.
# Scripts take it with `node --env-file=.env scripts/<script>.mjs`.
# Grants, rotation and the probe: docs/runbooks/credentials.md.
#
# Never put KEEPR_API_URL, KEEPR_INGESTION_URL, KEEPR_API_KEY or
# KEEPR_ADMINISTRATION_KEY here: they are the un-targeted local-runtime profile
# and the CLI refuses a file that sets them. Remote environments use --target.

# --- Production -------------------------------------------------------------
# Copy of a production API Worker bearer slot (API_BEARER_KEY). keepr --target production (API commands), release run production smoke.
KEEPR_PRODUCTION_API_KEY=
# Copy of a production ingestion Worker ADMINISTRATION_KEY slot. keepr --target production, release run staging|production. Never in GitHub.
KEEPR_PRODUCTION_ADMINISTRATION_KEY=

# --- GitHub -----------------------------------------------------------------
# Fine-grained PAT on KeeprDigital/card-keepr, Actions: write only. Dispatches and watches release workflows (release run, release staging|production).
KEEPR_GITHUB_RELEASE_TOKEN=

# --- Staging ----------------------------------------------------------------
# Copy of the staging API Worker API_BEARER_KEY (also GitHub staging secret STAGING_API_TRAFFIC_TOKEN). keepr --target staging.
KEEPR_STAGING_API_KEY=
# Copy of the staging API Worker API_BEARER_KEY_REPLACEMENT. Only for regenerating first-install secret JSON.
KEEPR_STAGING_API_KEY_REPLACEMENT=
# Copy of the staging ingestion Worker ADMINISTRATION_KEY. keepr --target staging, release run staging. Never in GitHub.
KEEPR_STAGING_ADMINISTRATION_KEY=
# Copy of the staging ingestion Worker ADMINISTRATION_KEY_REPLACEMENT. Only for regenerating first-install secret JSON.
KEEPR_STAGING_ADMINISTRATION_KEY_REPLACEMENT=
# Cloudflare token "card-keepr staging deploy" (= GitHub staging secret of the same name). Probe; CLOUDFLARE_API_TOKEN for provisioning.
STAGING_DEPLOYMENT_TOKEN=
# Not secret. Account hosting staging (= GitHub staging variable). Probe, provisioning, first install.
STAGING_CLOUDFLARE_ACCOUNT_ID=
# Not secret. D1 card-keepr-catalogue-staging UUID (= GitHub staging variable). Probe, first install.
STAGING_CATALOGUE_DATABASE_ID=
# Not secret. Initial D1 card-keepr-disposable-verification-staging UUID; the live one is re-resolved. Probe, first install.
STAGING_DISPOSABLE_DATABASE_ID=

# --- Dev --------------------------------------------------------------------
# Copy of the dev API Worker API_BEARER_KEY. keepr --target dev.
KEEPR_DEV_API_KEY=
# Copy of the dev ingestion Worker ADMINISTRATION_KEY. keepr --target dev. Never in GitHub.
KEEPR_DEV_ADMINISTRATION_KEY=
# Not secret. Same account as staging, kept per environment because scripts read <ENV>_CLOUDFLARE_ACCOUNT_ID. Probe, provisioning.
DEV_CLOUDFLARE_ACCOUNT_ID=
# Not secret. D1 card-keepr-catalogue-dev UUID (= GitHub dev variable). Probe, first install.
DEV_CATALOGUE_DATABASE_ID=
# Not secret. Initial D1 card-keepr-disposable-verification-dev UUID; the live one is re-resolved. Probe, first install.
DEV_DISPOSABLE_DATABASE_ID=

# --- Optional settings ------------------------------------------------------
# Not secret. Parent directory for release run worktrees; default ../card-keepr-worktrees.
# KEEPR_RELEASE_WORKTREE_ROOT=

# --- Set per invocation, never stored ----------------------------------------
# KEEPR_TOKEN_ADMIN: one-day bootstrap token for scripts/credential-tokens.mjs; revoke after use.
# KEEPR_PROBE_DEPLOYMENT_TOKEN / KEEPR_PROBE_D1_EXPORT_TOKEN / KEEPR_PROBE_D1_VERIFICATION_TOKEN: tokens under test by scripts/credential-probe.mjs.
# CLOUDFLARE_API_TOKEN, GH_TOKEN ("$(gh auth token)"), API_TRAFFIC_TOKEN, EXPECTED_HEAD_SHA, CI_RUN_ID: one-time provisioning and first install.
# D1_EXPORT_TOKEN / D1_VERIFICATION_TOKEN: live only as Worker secrets; issue fresh values when (re)installing.
