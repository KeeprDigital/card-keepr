{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-keepr.invalid/schemas/catalogue-export-manifest@2",
  "title": "Card Keepr Catalogue Export manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "serialization_profile",
    "export_schema_major",
    "catalogue_revision",
    "published_at",
    "export_created_at",
    "supported_games",
    "source_freshness",
    "components",
    "manifest_sha256"
  ],
  "properties": {
    "format": {
      "const": "card-keepr-catalogue-export-manifest@2"
    },
    "serialization_profile": {
      "const": "card-keepr-ndjson-gzip@1"
    },
    "export_schema_major": { "const": 2 },
    "catalogue_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_sha256"],
      "properties": {
        "id": {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/OpaqueId"
        },
        "content_sha256": {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Sha256"
        }
      }
    },
    "published_at": {
      "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Timestamp"
    },
    "export_created_at": {
      "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Timestamp"
    },
    "supported_games": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/SupportedGame"
      }
    },
    "source_freshness": {
      "type": "array",
      "items": {
        "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Freshness"
      }
    },
    "components": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/SupportedGamesComponent" },
        { "$ref": "#/$defs/GameProfilesComponent" },
        { "$ref": "#/$defs/CardsComponent" },
        { "$ref": "#/$defs/PrintingsComponent" },
        { "$ref": "#/$defs/PrintingImagesComponent" },
        { "$ref": "#/$defs/ProductsComponent" },
        { "$ref": "#/$defs/ReleasesComponent" },
        { "$ref": "#/$defs/DistributionContextsComponent" },
        { "$ref": "#/$defs/ErrataComponent" },
        { "$ref": "#/$defs/LegalityRulesComponent" },
        { "$ref": "#/$defs/RelationshipsComponent" }
      ],
      "items": false
    },
    "manifest_sha256": {
      "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Sha256"
    }
  },
  "$defs": {
    "SupportedGamesComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "supported-games" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/SupportedGameRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "GameProfilesComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "game-profiles" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/GameProfileRecord"
            },
            "order": { "const": "profile:utf8" }
          }
        }
      ]
    },
    "CardsComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "cards" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/CardRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "PrintingsComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "printings" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/PrintingRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "PrintingImagesComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "printing-images" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/PrintingImageRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "ProductsComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "products" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/ProductRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "ReleasesComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "releases" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/ReleaseRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "DistributionContextsComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "distribution-contexts" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/DistributionContextRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "ErrataComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "errata" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/ErratumRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "LegalityRulesComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "legality-rules" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/LegalityRuleRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "RelationshipsComponent": {
      "allOf": [
        {
          "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1#/$defs/Component"
        },
        {
          "type": "object",
          "properties": {
            "name": { "const": "relationships" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@2#/$defs/RelationshipRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    }
  }
}
