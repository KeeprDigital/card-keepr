{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-keepr.invalid/schemas/catalogue-export-manifest@3",
  "title": "Card Keepr Catalogue Export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "serialization_profile",
    "export_schema_major",
    "catalogue_revision",
    "published_at",
    "export_created_at",
    "supported_games",
    "source_freshness",
    "components",
    "manifest_sha256"
  ],
  "properties": {
    "format": { "const": "card-keepr-catalogue-export-manifest@3" },
    "serialization_profile": { "const": "card-keepr-ndjson-gzip@1" },
    "export_schema_major": { "const": 3 },
    "catalogue_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/OpaqueId" },
        "content_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "published_at": { "$ref": "#/$defs/Timestamp" },
    "export_created_at": { "$ref": "#/$defs/Timestamp" },
    "supported_games": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/SupportedGame" }
    },
    "source_freshness": {
      "type": "array",
      "items": { "$ref": "#/$defs/Freshness" }
    },
    "components": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/SupportedGamesComponent" },
        { "$ref": "#/$defs/GameProfilesComponent" },
        { "$ref": "#/$defs/CardsComponent" },
        { "$ref": "#/$defs/PrintingsComponent" },
        { "$ref": "#/$defs/PrintingImagesComponent" },
        { "$ref": "#/$defs/ProductsComponent" },
        { "$ref": "#/$defs/ReleasesComponent" },
        { "$ref": "#/$defs/DistributionContextsComponent" },
        { "$ref": "#/$defs/ErrataComponent" },
        { "$ref": "#/$defs/LegalityRulesComponent" },
        { "$ref": "#/$defs/RelationshipsComponent" }
      ],
      "items": false
    },
    "manifest_sha256": { "$ref": "#/$defs/Sha256" }
  },
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "SupportedGame": {
      "enum": ["one-piece", "fusion-world", "digimon", "gundam"]
    },
    "Freshness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["game", "area", "checked_at"],
          "properties": {
            "game": { "$ref": "#/$defs/SupportedGame" },
            "area": {
              "enum": [
                "cards-and-printings",
                "products-and-releases",
                "errata"
              ]
            },
            "checked_at": { "$ref": "#/$defs/Timestamp" }
          }
        },
        {
          "$ref": "#/$defs/OnePieceLegalityFreshness"
        },
        {
          "$ref": "#/$defs/FusionWorldLegalityFreshness"
        },
        {
          "$ref": "#/$defs/DigimonLegalityFreshness"
        },
        {
          "$ref": "#/$defs/GundamAsiaLegalityFreshness"
        },
        {
          "$ref": "#/$defs/GundamUsLegalityFreshness"
        }
      ]
    },
    "OnePieceLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "one-piece" },
        "source_lineage": { "const": "one-piece-en" },
        "region": { "const": "EN-OCEANIA" }
      }
    },
    "FusionWorldLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "fusion-world" },
        "source_lineage": { "const": "fusion-world-en" },
        "region": { "const": "EN-OCEANIA" }
      }
    },
    "DigimonLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "digimon" },
        "source_lineage": { "const": "digimon-en" },
        "region": { "const": "EN-OCEANIA" }
      }
    },
    "GundamAsiaLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "gundam" },
        "source_lineage": { "const": "gundam-en-asia" },
        "region": { "const": "EN-ASIA" }
      }
    },
    "GundamUsLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "gundam" },
        "source_lineage": { "const": "gundam-en-us" },
        "region": { "const": "EN-US" }
      }
    },
    "ScopedLegalityFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game",
        "area",
        "source_lineage",
        "region",
        "checked_at"
      ],
      "properties": {
        "game": { "$ref": "#/$defs/SupportedGame" },
        "area": { "const": "legality-rules" },
        "source_lineage": { "type": "string" },
        "region": { "enum": ["EN-OCEANIA", "EN-ASIA", "EN-US"] },
        "checked_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "media_type",
        "compression",
        "record_schema",
        "order",
        "records",
        "uncompressed_bytes",
        "content_sha256",
        "compressed_bytes",
        "compressed_sha256",
        "content_url"
      ],
      "properties": {
        "name": { "type": "string" },
        "media_type": { "const": "application/x-ndjson" },
        "compression": { "const": "gzip" },
        "record_schema": { "type": "string", "format": "uri-reference" },
        "order": { "enum": ["id:utf8", "profile:utf8"] },
        "records": { "type": "integer", "minimum": 0 },
        "uncompressed_bytes": { "type": "integer", "minimum": 0 },
        "content_sha256": { "$ref": "#/$defs/Sha256" },
        "compressed_bytes": { "type": "integer", "minimum": 0 },
        "compressed_sha256": { "$ref": "#/$defs/Sha256" },
        "content_url": {
          "type": "string",
          "pattern": "^/v1/catalogue-exports/[^/]+/components/[^/]+$"
        }
      }
    },
    "SupportedGamesComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "supported-games" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/SupportedGameRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "GameProfilesComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "game-profiles" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/GameProfileRecord"
            },
            "order": { "const": "profile:utf8" }
          }
        }
      ]
    },
    "CardsComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "cards" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/CardRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "PrintingsComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "printings" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/PrintingRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "PrintingImagesComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "printing-images" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/PrintingImageRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "ProductsComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "products" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/ProductRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "ReleasesComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "releases" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/ReleaseRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "DistributionContextsComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "distribution-contexts" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/DistributionContextRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "ErrataComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "errata" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/ErratumRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "LegalityRulesComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "legality-rules" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/LegalityRuleRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    },
    "RelationshipsComponent": {
      "allOf": [
        { "$ref": "#/$defs/Component" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "relationships" },
            "record_schema": {
              "const": "https://card-keepr.invalid/schemas/catalogue-export-record@3#/$defs/RelationshipRecord"
            },
            "order": { "const": "id:utf8" }
          }
        }
      ]
    }
  }
}
