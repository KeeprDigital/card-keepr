{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-keepr.invalid/schemas/read-api@1",
  "title": "Card Keepr read API representations",
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "SupportedGame": {
      "enum": ["one-piece", "fusion-world", "digimon", "gundam"]
    },
    "Region": {
      "enum": ["EN-OCEANIA", "EN-ASIA", "EN-US"]
    },
    "ReleaseRegion": {
      "enum": ["EN-OCEANIA", "EN-ASIA", "EN-US", "unknown"]
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_revision_id", "published_at"],
      "properties": {
        "catalogue_revision_id": { "$ref": "#/$defs/OpaqueId" },
        "published_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "SelfLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self"],
      "properties": {
        "self": { "type": "string", "pattern": "^/v1/" }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "next_cursor"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "next_cursor": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "OfficialIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "card_number" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "functional_designation" },
            "value": { "const": "DON!!" }
          }
        }
      ]
    },
    "GameData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "attributes"],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^(one-piece|fusion-world|digimon|gundam)@[1-9][0-9]*$"
        },
        "attributes": {
          "type": "object",
          "description": "Validated by the accepted versioned Game Profile."
        }
      }
    },
    "Lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_revision_id", "last_observed_revision_id", "withdrawn"],
      "properties": {
        "first_revision_id": { "$ref": "#/$defs/OpaqueId" },
        "last_observed_revision_id": { "$ref": "#/$defs/OpaqueId" },
        "withdrawn": { "type": "boolean" },
        "withdrawal": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["revision_id", "evidence"],
              "properties": {
                "revision_id": { "$ref": "#/$defs/OpaqueId" },
                "evidence": { "type": "object" }
              }
            }
          ]
        }
      }
    },
    "RelationshipEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_lineage",
        "relationship_kind",
        "relationship_value",
        "source_observation_ids",
        "first_revision_id",
        "last_observed_revision_id",
        "current",
        "last_missing_revision_id"
      ],
      "properties": {
        "source_lineage": { "type": "string", "minLength": 1 },
        "relationship_kind": {
          "enum": ["product", "distribution_context"]
        },
        "relationship_value": { "type": "string", "minLength": 1 },
        "source_observation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "first_revision_id": { "$ref": "#/$defs/OpaqueId" },
        "last_observed_revision_id": { "$ref": "#/$defs/OpaqueId" },
        "current": { "type": "boolean" },
        "last_missing_revision_id": {
          "oneOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        }
      }
    },
    "LocatorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_lineage",
        "locator",
        "variant_key",
        "first_revision_id",
        "last_observed_revision_id",
        "current",
        "last_missing_revision_id"
      ],
      "properties": {
        "source_lineage": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "variant_key": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "first_revision_id": { "$ref": "#/$defs/OpaqueId" },
        "last_observed_revision_id": { "$ref": "#/$defs/OpaqueId" },
        "current": { "type": "boolean" },
        "last_missing_revision_id": {
          "oneOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        }
      }
    },
    "LocatorEvidenceCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "historical"],
      "properties": {
        "current": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocatorEvidence" }
        },
        "historical": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocatorEvidence" }
        }
      }
    },
    "CardSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "game",
        "official_identity",
        "name",
        "game_data",
        "lifecycle",
        "links"
      ],
      "properties": {
        "type": { "const": "card" },
        "id": { "$ref": "#/$defs/OpaqueId" },
        "game": { "$ref": "#/$defs/SupportedGame" },
        "official_identity": { "$ref": "#/$defs/OfficialIdentity" },
        "name": { "type": "string", "minLength": 1 },
        "game_data": { "$ref": "#/$defs/GameData" },
        "source_lineages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lifecycle": { "$ref": "#/$defs/Lifecycle" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "CardDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "game",
        "official_identity",
        "name",
        "game_data",
        "effective_rules_text",
        "printing_ids",
        "lifecycle",
        "links"
      ],
      "properties": {
        "type": { "const": "card" },
        "id": { "$ref": "#/$defs/OpaqueId" },
        "game": { "$ref": "#/$defs/SupportedGame" },
        "official_identity": { "$ref": "#/$defs/OfficialIdentity" },
        "name": { "type": "string", "minLength": 1 },
        "game_data": { "$ref": "#/$defs/GameData" },
        "effective_rules_text": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "printing_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "source_lineages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lifecycle": { "$ref": "#/$defs/Lifecycle" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "Rarity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized", "raw"],
      "properties": {
        "normalized": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "raw": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "PrintingImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "printing_id",
        "role",
        "media_type",
        "width",
        "height",
        "content_sha256",
        "links"
      ],
      "properties": {
        "type": { "const": "printing_image" },
        "id": { "$ref": "#/$defs/OpaqueId" },
        "printing_id": { "$ref": "#/$defs/OpaqueId" },
        "role": { "enum": ["front", "back", "other"] },
        "media_type": { "type": "string", "pattern": "^image/" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/Sha256" },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["self", "content"],
          "properties": {
            "self": { "type": "string", "pattern": "^/v1/" },
            "content": {
              "type": "string",
              "pattern": "^/v1/printing-images/[^/]+/content$"
            }
          }
        }
      }
    },
    "DistributionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "product_id", "evidence_category"],
      "properties": {
        "id": { "$ref": "#/$defs/OpaqueId" },
        "kind": { "enum": ["product", "tournament_pack", "winner_prize", "promotion", "other"] },
        "label": { "type": "string", "minLength": 1 },
        "product_id": {
          "oneOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "evidence_category": { "enum": ["explicit", "derived", "curated"] },
        "source_lineage": { "type": "string", "minLength": 1 },
        "source_observation_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OpaqueId" },
          "uniqueItems": true
        }
      }
    },
    "PrintingProductProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "official_code",
        "name",
        "evidence_category",
        "source_lineage",
        "source_observation_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/OpaqueId" },
        "official_code": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "name": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "evidence_category": { "enum": ["explicit", "derived", "curated"] },
        "source_lineage": { "type": "string", "minLength": 1 },
        "source_observation_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OpaqueId" },
          "uniqueItems": true
        }
      }
    },
    "Printing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "card_id",
        "rarity",
        "printed_rules_text",
        "game_data",
        "printing_images",
        "distribution_contexts",
        "relationship_evidence",
        "locator_evidence",
        "lifecycle",
        "links"
      ],
      "properties": {
        "type": { "const": "printing" },
        "id": { "$ref": "#/$defs/OpaqueId" },
        "card_id": { "$ref": "#/$defs/OpaqueId" },
        "rarity": { "$ref": "#/$defs/Rarity" },
        "printed_rules_text": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "game_data": {
          "oneOf": [{ "$ref": "#/$defs/GameData" }, { "type": "null" }]
        },
        "printing_images": {
          "type": "array",
          "items": { "$ref": "#/$defs/PrintingImage" }
        },
        "products": {
          "type": "array",
          "items": { "$ref": "#/$defs/PrintingProductProjection" }
        },
        "distribution_contexts": {
          "type": "array",
          "items": { "$ref": "#/$defs/DistributionContext" }
        },
        "relationship_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/RelationshipEvidence" }
        },
        "locator_evidence": {
          "$ref": "#/$defs/LocatorEvidenceCollection"
        },
        "source_lineages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lifecycle": { "$ref": "#/$defs/Lifecycle" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "ReleaseDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "value"],
      "properties": {
        "precision": { "enum": ["day", "month", "quarter", "year", "unknown"] },
        "value": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "Release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event_key", "region", "date", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/OpaqueId" },
        "event_key": { "$ref": "#/$defs/OpaqueId" },
        "region": { "$ref": "#/$defs/ReleaseRegion" },
        "date": { "$ref": "#/$defs/ReleaseDate" },
        "status": {
          "oneOf": [
            { "enum": ["announced", "released"] },
            { "type": "null" }
          ]
        }
      }
    },
    "Product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "game", "official_code", "name", "releases", "lifecycle", "links"],
      "properties": {
        "type": { "const": "product" },
        "id": { "$ref": "#/$defs/OpaqueId" },
        "game": { "$ref": "#/$defs/SupportedGame" },
        "official_code": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "name": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "releases": {
          "type": "array",
          "items": { "$ref": "#/$defs/Release" }
        },
        "lifecycle": { "$ref": "#/$defs/Lifecycle" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "Provenance": {
      "type": "object",
      "propertyNames": { "pattern": "^/" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "Disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "candidates"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "status": {
          "enum": ["unresolved", "resolved_by_authority"]
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "observation_id"],
            "properties": {
              "value": {},
              "observation_id": { "$ref": "#/$defs/OpaqueId" }
            }
          }
        }
      }
    },
    "Freshness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["game", "area", "checked_at"],
          "properties": {
            "game": { "$ref": "#/$defs/SupportedGame" },
            "area": {
              "enum": [
                "cards-and-printings",
                "products-and-releases",
                "errata"
              ]
            },
            "checked_at": { "$ref": "#/$defs/Timestamp" }
          }
        },
        {
          "$ref": "#/$defs/OnePieceLegalityFreshness"
        },
        {
          "$ref": "#/$defs/FusionWorldLegalityFreshness"
        },
        {
          "$ref": "#/$defs/DigimonLegalityFreshness"
        },
        {
          "$ref": "#/$defs/GundamAsiaLegalityFreshness"
        },
        {
          "$ref": "#/$defs/GundamUsLegalityFreshness"
        }
      ]
    },
    "OnePieceLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "one-piece" },
        "source_lineage": { "const": "one-piece-en" },
        "region": { "const": "EN-OCEANIA" }
      }
    },
    "FusionWorldLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "fusion-world" },
        "source_lineage": { "const": "fusion-world-en" },
        "region": { "const": "EN-OCEANIA" }
      }
    },
    "DigimonLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "digimon" },
        "source_lineage": { "const": "digimon-en" },
        "region": { "const": "EN-OCEANIA" }
      }
    },
    "GundamAsiaLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "gundam" },
        "source_lineage": { "const": "gundam-en-asia" },
        "region": { "const": "EN-ASIA" }
      }
    },
    "GundamUsLegalityFreshness": {
      "$ref": "#/$defs/ScopedLegalityFreshness",
      "properties": {
        "game": { "const": "gundam" },
        "source_lineage": { "const": "gundam-en-us" },
        "region": { "const": "EN-US" }
      }
    },
    "ScopedLegalityFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game",
        "area",
        "source_lineage",
        "region",
        "checked_at"
      ],
      "properties": {
        "game": { "$ref": "#/$defs/SupportedGame" },
        "area": { "const": "legality-rules" },
        "source_lineage": { "type": "string" },
        "region": { "enum": ["EN-OCEANIA", "EN-ASIA", "EN-US"] },
        "checked_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "CatalogueDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "links"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "current_revision_id",
            "published_at",
            "last_successful_checks",
            "current_export"
          ],
          "properties": {
            "type": { "const": "catalogue" },
            "current_revision_id": { "$ref": "#/$defs/OpaqueId" },
            "published_at": { "$ref": "#/$defs/Timestamp" },
            "last_successful_checks": {
              "type": "array",
              "items": { "$ref": "#/$defs/Freshness" }
            },
            "current_export": {
              "type": "string",
              "pattern": "^/v1/catalogue-exports/"
            }
          }
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "links": {
          "type": "object",
          "required": ["self", "cards", "printings", "products", "catalogue_exports"],
          "properties": {
            "self": { "const": "/v1/catalogue" },
            "cards": { "const": "/v1/cards" },
            "printings": { "const": "/v1/printings" },
            "products": { "const": "/v1/products" },
            "catalogue_exports": { "const": "/v1/catalogue-exports" }
          },
          "additionalProperties": false
        }
      }
    },
    "CardCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "page", "links"],
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/CardSummary" }
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "page": { "$ref": "#/$defs/Page" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "CardDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "links"],
      "properties": {
        "data": { "$ref": "#/$defs/CardDetail" },
        "included": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/Printing" },
              { "$ref": "#/$defs/EvidenceResource" }
            ]
          }
        },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "disagreements": {
          "type": "array",
          "items": { "$ref": "#/$defs/Disagreement" }
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "PrintingCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "page", "links"],
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/Printing" }
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "page": { "$ref": "#/$defs/Page" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "PrintingDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "links"],
      "properties": {
        "data": { "$ref": "#/$defs/Printing" },
        "included": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceResource" }
        },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "disagreements": {
          "type": "array",
          "items": { "$ref": "#/$defs/Disagreement" }
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "ProductCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "page", "links"],
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/Product" }
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "page": { "$ref": "#/$defs/Page" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "ProductDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "links"],
      "properties": {
        "data": { "$ref": "#/$defs/Product" },
        "included": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceResource" }
        },
        "provenance": {
          "description": "JSON Pointers may address Product facts or nested Release facts, for example /data/releases/0/date/value.",
          "$ref": "#/$defs/Provenance"
        },
        "disagreements": {
          "type": "array",
          "items": { "$ref": "#/$defs/Disagreement" }
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "EvidenceResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "captured_at", "source"],
      "properties": {
        "type": { "enum": ["source_observation", "curated_revision"] },
        "id": { "$ref": "#/$defs/OpaqueId" },
        "captured_at": { "$ref": "#/$defs/Timestamp" },
        "source": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "request_role": {
          "enum": ["surface", "listing", "detail", "product_detail", "image"]
        },
        "authority_class": {
          "enum": [
            "product_detail",
            "release_schedule",
            "product_listing",
            "card_detail",
            "card_listing",
            "policy",
            "unknown"
          ]
        }
      }
    },
    "LegalityStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "on",
        "format",
        "event_tier",
        "region",
        "status",
        "rule_ids",
        "unresolved_scope_rule_ids",
        "derivation"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/OpaqueId" },
        "on": { "type": "string", "format": "date" },
        "format": { "type": "string", "minLength": 1 },
        "event_tier": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "region": { "$ref": "#/$defs/Region" },
        "status": { "enum": ["legal", "restricted", "not_legal", "indeterminate"] },
        "rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "unresolved_scope_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "derivation": { "type": "string", "minLength": 1 }
      }
    },
    "LegalityStatusDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "links"],
      "dependentRequired": {
        "included": ["provenance"],
        "provenance": ["included"]
      },
      "properties": {
        "data": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/LegalityStatus" }
        },
        "included": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceResource" }
        },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "meta": { "$ref": "#/$defs/Meta" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "CatalogueExportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "catalogue_revision_id",
        "export_schema_major",
        "published_at",
        "manifest_sha256",
        "links"
      ],
      "properties": {
        "type": { "const": "catalogue_export" },
        "catalogue_revision_id": { "$ref": "#/$defs/OpaqueId" },
        "export_schema_major": { "type": "integer", "minimum": 1 },
        "published_at": { "$ref": "#/$defs/Timestamp" },
        "manifest_sha256": { "$ref": "#/$defs/Sha256" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "CatalogueExportCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "page", "links"],
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/CatalogueExportSummary" }
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "page": { "$ref": "#/$defs/Page" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "CatalogueExportDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta", "links"],
      "properties": {
        "data": {
          "oneOf": [
            {
              "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@1"
            },
            {
              "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@2"
            },
            {
              "$ref": "https://card-keepr.invalid/schemas/catalogue-export-manifest@3"
            }
          ]
        },
        "meta": { "$ref": "#/$defs/Meta" },
        "links": { "$ref": "#/$defs/SelfLink" }
      }
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "status", "code", "detail", "request_id"],
      "properties": {
        "type": { "type": "string", "format": "uri-reference" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "code": {
          "enum": [
            "authentication_required",
            "invalid_api_key",
            "forbidden_origin",
            "not_found",
            "invalid_parameter",
            "invalid_cursor",
            "cursor_revision_unavailable",
            "catalogue_query_unavailable",
            "catalogue_export_deleted",
            "invalid_legality_region",
            "range_not_satisfiable",
            "rate_limited",
            "internal_error"
          ]
        },
        "detail": { "type": "string", "minLength": 1 },
        "request_id": { "$ref": "#/$defs/OpaqueId" },
        "invalid_params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": { "type": "string", "format": "uri-reference" }
        }
      }
    }
  }
}
