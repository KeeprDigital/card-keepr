{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "card-keepr-ingestion",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMINISTRATION_CLOCK_MODE": "system",
    "CLOUDFLARE_ACCOUNT_ID": "0123456789abcdef0123456789abcdef",
    "CATALOGUE_D1_DATABASE_ID": "00000000-0000-0000-0000-000000000001",
    "DISPOSABLE_D1_DATABASE_ID": "00000000-0000-0000-0000-000000000002",
    "GITHUB_REPOSITORY_ID": "repository-KeeprDigital-card-keepr"
  },
  "placement": {
    "mode": "smart"
  },
  "workflows": [
    {
      "name": "card-keepr-evidence-ingestion",
      "binding": "EVIDENCE_INGESTION_WORKFLOW",
      "class_name": "EvidenceIngestionWorkflow"
    },
    {
      "name": "card-keepr-evidence-host",
      "binding": "EVIDENCE_HOST_WORKFLOW",
      "class_name": "EvidenceHostWorkflow"
    }
  ],
  "services": [
    {
      "binding": "OFFICIAL_SOURCE_TRANSPORT",
      "service": "card-keepr-ingestion",
      "entrypoint": "OfficialSourceTransport"
    }
  ],
  "d1_databases": [
    {
      "binding": "CATALOGUE_DB",
      "database_name": "card-keepr-catalogue",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE_OBJECTS",
      "bucket_name": "card-keepr-evidence"
    },
    {
      "binding": "PRINTING_IMAGES",
      "bucket_name": "card-keepr-printing-images"
    },
    {
      "binding": "CATALOGUE_EXPORTS",
      "bucket_name": "card-keepr-catalogue-exports"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "card-keepr-backups"
    }
  ],
  "ratelimits": [
    {
      "name": "ADMINISTRATION_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
