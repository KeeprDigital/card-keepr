{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "card-keepr-ingestion",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMINISTRATION_CLOCK_MODE": "system",
    "CLOUDFLARE_ACCOUNT_ID": "3ec389380c7b82e6a172e6f351d4aad9",
    "CATALOGUE_D1_DATABASE_ID": "c832fb49-abfc-48a4-80e3-f788b30d954f",
    "DISPOSABLE_D1_DATABASE_ID": "720d71a4-bf57-4a88-b010-937786eddda4",
    "GITHUB_REPOSITORY_ID": "1313489088",
    "GITHUB_APP_ID": "0",
    "GITHUB_INSTALLATION_ID": "0",
    "GITHUB_ENVIRONMENT_ID": "0",
    "GITHUB_WORKFLOW_ID": "0"
  },
  "placement": {
    "mode": "smart"
  },
  "workflows": [
    {
      "name": "card-keepr-evidence-ingestion",
      "binding": "EVIDENCE_INGESTION_WORKFLOW",
      "class_name": "EvidenceIngestionWorkflow"
    },
    {
      "name": "card-keepr-evidence-host",
      "binding": "EVIDENCE_HOST_WORKFLOW",
      "class_name": "EvidenceHostWorkflow"
    },
    {
      "name": "card-keepr-reconciliation",
      "binding": "RECONCILIATION_WORKFLOW",
      "class_name": "ReconciliationWorkflow"
    },
    {
      "name": "card-keepr-catalogue-backup",
      "binding": "CATALOGUE_BACKUP_WORKFLOW",
      "class_name": "CatalogueBackupWorkflow"
    }
  ],
  "services": [
    {
      "binding": "API_CREDENTIAL_CONSUMER",
      "service": "card-keepr-api",
      "entrypoint": "ApiCredentialConsumer"
    },
    {
      "binding": "OFFICIAL_SOURCE_TRANSPORT",
      "service": "card-keepr-ingestion",
      "entrypoint": "OfficialSourceTransport"
    }
  ],
  "d1_databases": [
    {
      "binding": "CATALOGUE_DB",
      "database_name": "card-keepr-catalogue",
      "database_id": "c832fb49-abfc-48a4-80e3-f788b30d954f",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE_OBJECTS",
      "bucket_name": "card-keepr-evidence"
    },
    {
      "binding": "PRINTING_IMAGES",
      "bucket_name": "card-keepr-printing-images"
    },
    {
      "binding": "CATALOGUE_EXPORTS",
      "bucket_name": "card-keepr-catalogue-exports"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "card-keepr-backups"
    }
  ],
  "ratelimits": [
    {
      "name": "ADMINISTRATION_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
