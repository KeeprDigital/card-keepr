{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/vitest-plugin/types", "node"],
    "allowJs": true,
  },
  "include": [
    "../worker-configuration.d.ts",
    "./**/*.ts",
    "../vitest.config.ts",
    "../../../test/support/**/*.ts",
    "../../../test/support/**/*.mjs",
  ],
  // Generated validator bundles are typed by their .d.mts declaration.
  "exclude": ["../../../test/support/api-worker.ts", "../../../test/support/http-response-validators*.mjs"],
}
