{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "card-keepr-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000",
    "CATALOGUE_REVISION_ID": "catrev_spine_000",
    "CATALOGUE_PUBLISHED_AT": "1970-01-01T00:00:00.000Z"
  },
  "d1_databases": [
    {
      "binding": "CATALOGUE_DB",
      "database_name": "card-keepr-catalogue",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRINTING_IMAGES",
      "bucket_name": "card-keepr-printing-images"
    }
  ],
  "ratelimits": [
    {
      "name": "CATALOGUE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PRINTING_IMAGE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
