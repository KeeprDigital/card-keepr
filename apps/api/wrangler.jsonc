{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "card-keepr-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "CATALOGUE_DB",
      "database_name": "card-keepr-catalogue",
      "database_id": "893e8c67-08d1-4363-8796-11ea12e14f65",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRINTING_IMAGES",
      "bucket_name": "card-keepr-printing-images"
    },
    {
      "binding": "CATALOGUE_EXPORTS",
      "bucket_name": "card-keepr-catalogue-exports"
    }
  ],
  "ratelimits": [
    {
      "name": "CATALOGUE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PRINTING_IMAGE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
