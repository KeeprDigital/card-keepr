{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Issue #75: a lint gate plus a format check scoped to changed files. A
  // full format pass touched 209 files (+27k/-41k lines), so the formatter
  // ratchets: a file is formatted when a pull request changes it
  // (`pnpm run format`), never repository-wide in one commit.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
  "files": {
    "includes": [
      "**",
      // Throwaway prototypes and retained official-source captures are not
      // maintained code.
      "!prototype",
      "!acceptance/fixtures",
      // Generated by `pnpm run generate:worker-types`.
      "!**/worker-configuration.d.ts",
      "!pnpm-lock.yaml",
      // Ahead-of-time Ajv output; verified by check:generated.
      "!src/catalogue/shared/document-validators.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Existing code leans on `!` after guarded lookups; the rule would
      // fight it in hundreds of places.
      "style": { "noNonNullAssertion": "off" },
      // Recommended-as-error rules the code base violates today. They warn
      // until the findings are cleared, then move back to error.
      "correctness": { "noVoidTypeReturn": "warn" },
      "suspicious": {
        "noControlCharactersInRegex": "warn",
        "noImplicitAnyLet": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  }
}
