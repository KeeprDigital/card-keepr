"mimeType":"image/svg+xml"}}},{"media":{"type":"image","provider":"sanity","url":"https://cmsassets.rgpub.io/sanity/images/dsfx7636/news_live/6c18d935994f252962e9d797d624cbc0dbea7324-3276x1843.png?accountingTag=RB","dimensions":{"width":3276,"height":1843,"aspectRatio":1.7775366250678242},"colors":{"primary":"#ABB8A6","secondary":"#292F33","label":"#3B5930"},"mimeType":"image/png"},"imageMedia":{"type":"image","provider":"sanity","url":"https://cmsassets.rgpub.io/sanity/images/dsfx7636/news_live/6c18d935994f252962e9d797d624cbc0dbea7324-3276x1843.png?accountingTag=RB","dimensions":{"width":3276,"height":1843,"aspectRatio":1.7775366250678242},"colors":{"primary":"#ABB8A6","secondary":"#292F33","label":"#3B5930"},"mimeType":"image/png"},"title":"Korea’s Rift Opens on September 18","action":{"type":"weblink","payload":{"url":"/en-us/news/announcements/koreas-rift-opens-on-september-18"}},"analytics":{"contentId":"62b460df-c5c7-46f7-844a-33eec8f29bce.en-us","contentLocale":"en-us","rev":"2F6Gi7UpmNXkgIxB1YoJtN","publishDate":"2026-09-02T16:00:00.000Z"},"category":{"machineName":"announcements","title":"Announcements"},"description":{"type":"html","body":"South Korea is getting ready for Riftbound."},"publishedAt":"2026-09-02T16:00:00.000Z","product":{"title":"Riftbound","machineName":"riftbound","id":"product.riftbound.en-us","media":{"type":"image","provider":"sanity","url":"https://cmsassets.rgpub.io/sanity/images/dsfx7636/riotbar_live/4da88ec91ad2d6d108ce89a62dcd1c05e764f724-24x24.svg?accountingTag=RB","dimensions":{"width":24,"height":24,"aspectRatio":1},"mimeType":"image/svg+xml"}}},{"media":{"type":"image","provider":"sanity","url":"https://cmsassets.rgpub.io/sanity/images/dsfx7636/news_live/2871b8ee8a7d54385dd10ee56fb07ccb84835935-4180x2352.jpg?accountingTag=RB","dimensions":{"width":4180,"height":2352,"aspectRatio":1.7772108843537415},"colors":{"primary":"#604530","secondary":"#F9EEDC","label":"#3A220F"},"mimeType":"image/jpeg"},"imageMedia":{"type":"image","prov