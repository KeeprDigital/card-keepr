{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Card Keepr read API",
    "version": "1.1.0-prototype",
    "description": "Authenticated, read-only access to one atomically published Catalogue Revision. This prototype contract is a discussion artifact, not a deployed API.",
    "license": {
      "name": "Unlicensed private prototype",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://card-keepr.invalid/v1",
      "description": "Production base; deployment supplies the real hostname."
    }
  ],
  "security": [
    {
      "apiBearer": []
    }
  ],
  "tags": [
    {
      "name": "Catalogue",
      "description": "Current Catalogue Revision."
    },
    {
      "name": "Cards",
      "description": "Rules-level Cards and their game-specific facts."
    },
    {
      "name": "Printings",
      "description": "Officially distinguished Printings and immutable Printing Images."
    },
    {
      "name": "Products",
      "description": "Official Products and region-scoped Releases."
    },
    {
      "name": "Catalogue Exports",
      "description": "Immutable offline packages for Catalogue Revisions."
    }
  ],
  "paths": {
    "/catalogue": {
      "get": {
        "operationId": "getCatalogue",
        "tags": ["Catalogue"],
        "summary": "Get the current Catalogue Revision",
        "responses": {
          "200": {
            "description": "Current published catalogue status, without administrative source health.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/CatalogueDocument"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/cards": {
      "get": {
        "operationId": "listCards",
        "tags": ["Cards"],
        "summary": "Browse, search, and filter Cards",
        "description": "Order is Supported Game, official identity kind, official identity value, then opaque Card identity. q is an exact case-insensitive Unicode substring search over official identity value, name, and Effective Rules Text without crossing field boundaries.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "$ref": "#/components/parameters/Game"
          },
          {
            "name": "card_number",
            "in": "query",
            "description": "Exact numbered-card identity within game. It never matches the generic DON!! Card.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/After"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated Card summaries.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/CardCollection"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "409": {
            "$ref": "#/components/responses/CursorUnavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/CatalogueQueryUnavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/cards/{card_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CardId"
        }
      ],
      "get": {
        "operationId": "getCard",
        "tags": ["Cards"],
        "summary": "Get one Card",
        "parameters": [
          {
            "name": "include",
            "in": "query",
            "description": "Optional sidecars. Unknown values fail with invalid_parameter.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["printings"]
              }
            }
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Card detail. Unresolved canonical values remain null.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/CardDocument"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/printings": {
      "get": {
        "operationId": "listPrintings",
        "tags": ["Printings"],
        "summary": "Browse and filter Printings",
        "description": "Every supplied constraint must be satisfied by the same Printing. Order is Card identity then opaque Printing identity.",
        "parameters": [
          {
            "name": "card_id",
            "in": "query",
            "schema": {
              "$ref": "./schemas/api.schema.json#/$defs/OpaqueId"
            }
          },
          {
            "$ref": "#/components/parameters/Game"
          },
          {
            "name": "rarity",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "product_id",
            "in": "query",
            "schema": {
              "$ref": "./schemas/api.schema.json#/$defs/OpaqueId"
            }
          },
          {
            "name": "release_region",
            "in": "query",
            "schema": {
              "$ref": "./schemas/api.schema.json#/$defs/ReleaseRegion"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/After"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated Printings.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/PrintingCollection"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "409": {
            "$ref": "#/components/responses/CursorUnavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/printings/{printing_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PrintingId"
        }
      ],
      "get": {
        "operationId": "getPrinting",
        "tags": ["Printings"],
        "summary": "Get one Printing",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Printing detail, its Printing Images, and Distribution Contexts.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/PrintingDocument"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/printing-images/{image_id}/content": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ImageId"
        }
      ],
      "get": {
        "operationId": "getPrintingImageContent",
        "tags": ["Printings"],
        "summary": "Stream immutable authenticated Printing Image bytes",
        "parameters": [
          {
            "$ref": "#/components/parameters/Range"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ImmutableBinary"
          },
          "206": {
            "$ref": "#/components/responses/PartialBinary"
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "416": {
            "$ref": "#/components/responses/RangeNotSatisfiable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "operationId": "headPrintingImageContent",
        "tags": ["Printings"],
        "summary": "Read immutable Printing Image metadata without a body",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ImmutableBinaryHead"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "tags": ["Products"],
        "summary": "Browse and search Products",
        "description": "Order is Supported Game, official Product code with null last, name, then opaque Product identity.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "$ref": "#/components/parameters/Game"
          },
          {
            "name": "release_region",
            "in": "query",
            "schema": {
              "$ref": "./schemas/api.schema.json#/$defs/ReleaseRegion"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/After"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated Products and their regional Releases.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/ProductCollection"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "409": {
            "$ref": "#/components/responses/CursorUnavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/products/{product_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProductId"
        }
      ],
      "get": {
        "operationId": "getProduct",
        "tags": ["Products"],
        "summary": "Get one Product and its regional Releases",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Product detail.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/ProductDocument"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/catalogue-exports": {
      "get": {
        "operationId": "listCatalogueExports",
        "tags": ["Catalogue Exports"],
        "summary": "List verified retained Catalogue Exports",
        "description": "Order is descending publication time then descending opaque Catalogue Revision identity. Unverified exports never appear.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/After"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated verified Catalogue Exports.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/CatalogueExportCollection"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "409": {
            "$ref": "#/components/responses/CursorUnavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/catalogue-exports/{catalogue_revision_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CatalogueRevisionId"
        }
      ],
      "get": {
        "operationId": "getCatalogueExport",
        "tags": ["Catalogue Exports"],
        "summary": "Get one verified immutable Catalogue Export manifest",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Verified manifest and authenticated immutable component links.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalogue-Revision": {
                "$ref": "#/components/headers/CatalogueRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api.schema.json#/$defs/CatalogueExportDocument"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "410": {
            "$ref": "#/components/responses/CatalogueExportDeleted"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/catalogue-exports/{catalogue_revision_id}/components/{component}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CatalogueRevisionId"
        },
        {
          "name": "component",
          "in": "path",
          "required": true,
          "schema": {
            "enum": [
              "supported-games",
              "game-profiles",
              "cards",
              "printings",
              "printing-images",
              "products",
              "releases",
              "distribution-contexts",
              "errata",
              "relationships"
            ]
          }
        }
      ],
      "get": {
        "operationId": "getCatalogueExportComponent",
        "tags": ["Catalogue Exports"],
        "summary": "Stream one immutable gzip NDJSON component",
        "parameters": [
          {
            "$ref": "#/components/parameters/Range"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ImmutableBinary"
          },
          "206": {
            "$ref": "#/components/responses/PartialBinary"
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "410": {
            "$ref": "#/components/responses/CatalogueExportDeleted"
          },
          "416": {
            "$ref": "#/components/responses/RangeNotSatisfiable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "operationId": "headCatalogueExportComponent",
        "tags": ["Catalogue Exports"],
        "summary": "Read immutable component metadata without a body",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ImmutableBinaryHead"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "410": {
            "$ref": "#/components/responses/CatalogueExportDeleted"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque API traffic-gate key",
        "description": "One pre-shared extractable traffic gate. It is separate from the ingestion administration key."
      }
    },
    "parameters": {
      "Search": {
        "name": "q",
        "in": "query",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "Game": {
        "name": "game",
        "in": "query",
        "schema": {
          "$ref": "./schemas/api.schema.json#/$defs/SupportedGame"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "After": {
        "name": "after",
        "in": "query",
        "description": "Opaque cursor pinning route, normalized filters, order, limit, and Catalogue Revision.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "schema": {
          "type": "string"
        }
      },
      "Range": {
        "name": "Range",
        "in": "header",
        "description": "One RFC 9110 bytes range. Multiple ranges are not supported.",
        "schema": {
          "type": "string",
          "pattern": "^bytes="
        }
      },
      "CardId": {
        "name": "card_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "./schemas/api.schema.json#/$defs/OpaqueId"
        }
      },
      "PrintingId": {
        "name": "printing_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "./schemas/api.schema.json#/$defs/OpaqueId"
        }
      },
      "ImageId": {
        "name": "image_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "./schemas/api.schema.json#/$defs/OpaqueId"
        }
      },
      "ProductId": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "./schemas/api.schema.json#/$defs/OpaqueId"
        }
      },
      "CatalogueRevisionId": {
        "name": "catalogue_revision_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "./schemas/api.schema.json#/$defs/OpaqueId"
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "Strong ETag for immutable bytes; resource-representation ETag for JSON.",
        "schema": {
          "type": "string"
