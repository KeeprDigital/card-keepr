          "deadline": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "minLength": 1
          },
          "inspection_receipt": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "enum": [
              "approved",
              "waiting_artifacts",
              "waiting_backup",
              "retry_paused",
              "published",
              "failed"
            ]
          },
          "failure_code": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "resulting_revision_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "backup_attempt_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "approval_scope": {
            "type": "string",
            "enum": [
              "whole_candidate"
            ]
          }
        },
        "required": [
          "contract",
          "id",
          "candidate_id",
