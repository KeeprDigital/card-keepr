{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "keepr": "./cli/keepr.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --config apps/api/wrangler.jsonc --port 8787 --inspector-port 9229",
    "dev:ingestion": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --config apps/ingestion/wrangler.jsonc --port 8788 --inspector-port 9230",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply CATALOGUE_DB --local --config apps/ingestion/wrangler.jsonc",
    "keepr": "node cli/keepr.mjs",
    "test": "npm run test:domain && npm run test:api && npm run test:acceptance:smoke",
    "test:full": "npm run test:domain && npm run test:api && npm run test:ingestion && npm run test:acceptance",
    "test:domain": "vitest run --config test/domain/vitest.config.ts",
    "test:api": "vitest run --config apps/api/vitest.config.ts",
    "test:ingestion": "vitest run --config apps/ingestion/vitest.config.ts",
    "test:acceptance": "node scripts/acceptance-tier.mjs default",
    "test:acceptance:smoke": "node scripts/acceptance-tier.mjs smoke",
    "test:acceptance:extended": "node scripts/acceptance-tier.mjs extended",
    "test:benchmark": "node scripts/acceptance-tier.mjs benchmark",
    "test:stress": "KEEPR_TEST_SUITE=stress vitest run --config apps/ingestion/vitest.config.ts apps/ingestion/test/runtime-host-pacing.stress.spec.ts apps/ingestion/test/runtime-collection-throughput.stress.spec.ts",
    "test:stress:full": "KEEPR_TEST_SUITE=stress vitest run --config apps/ingestion/vitest.config.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:generated && npm run check:imports && npm run build",
    "lint": "biome lint .",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "typecheck": "tsc --project apps/api/tsconfig.json && tsc --project apps/api/test/tsconfig.json && tsc --project apps/ingestion/tsconfig.json && tsc --project apps/ingestion/test/tsconfig.json && tsc --project test/domain/tsconfig.json",
    "check:generated": "node scripts/worker-types.mjs --check && node scripts/document-validators.mjs --check",
    "check:imports": "node scripts/catalogue-import-cycles.mjs && node scripts/catalogue-import-boundary.mjs",
    "generate:worker-types": "node scripts/worker-types.mjs",
    "generate:validators": "node scripts/document-validators.mjs",
    "build": "npm run build:api && npm run build:ingestion",
    "build:api": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --config apps/api/wrangler.jsonc",
    "build:ingestion": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --config apps/ingestion/wrangler.jsonc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/vitest-plugin": "^1.1.6",
    "@types/node": "^26.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "entities": "8.1.0",
    "jsonc-parser": "^3.3.1",
    "libsodium-wrappers": "^0.8.4",
    "pako": "3.0.1",
    "parse5": "8.0.1"
  },
  "overrides": {
    "parse5": {
      "entities": "8.0.0"
    }
  }
}
